type Register<T>:
    operation Write:
        T -> void

    operation Read:
        void -> T
        V = exists in context where this same object as that: name == "Write";
        S = exists in context where this same object as that:
                (name == "Write") and (this.output == input[0])
                and not exists in that.future intersect this.context where this same object as that:
                    (name == "Write") and (input[0] != this.output);
